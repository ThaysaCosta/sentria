# Copie este arquivo para .env e ajuste se quiser.
# Sem chave da Anthropic, a SENTRIA usa o motor de IA local (funciona 100% offline).

# Chave da API do Claude (opcional) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelo do Claude usado na análise de tickets e no resumo executivo
CLAUDE_MODEL=claude-opus-5-5

# Porta da API
PORT=3333

# Segredo para assinar os tokens de login (troque em produção)
JWT_SECRET=troque-este-segredo
